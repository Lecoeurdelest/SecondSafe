# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Database (required)
MONGODB_URI=mongodb://localhost:27017/secondsafe

# Security (required)
JWT_SECRET=change-me
CHAT_ENCRYPTION_KEY=change-me-too

# Initial admin account (used by `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=

# Sample seller created by `npm run seed` (local development only)
SEED_SELLER_PASSWORD=
