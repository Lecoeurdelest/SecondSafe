# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
LOG_LEVEL=info

# Database (required)
MONGODB_URI=mongodb://localhost:27017/secondsafe
DEMO_MONGODB_URI=mongodb://127.0.0.1:27017/secondsafe_demo

# Security (required)
JWT_SECRET=change-me
CHAT_ENCRYPTION_KEY=change-me-too

# AI assistant (optional; required only for Gemini-backed assistant responses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional SMTP (EMAIL_USER/EMAIL_PASS remain supported for Gmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

EMAIL_USER=
EMAIL_PASS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=

# Initial admin account (used by `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=

# Real platform admin/staff accounts; new strong passwords are required
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_STAFF_EMAIL=
PLATFORM_STAFF_PASSWORD=

# Demo-only admin/staff accounts; use fresh strong passwords and do not commit .env
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Sample seller created by `npm run seed` (local development only)
SEED_SELLER_PASSWORD=

# Business overrides (integer VND and milliseconds unless noted)
PLATFORM_FEE_RATE=0.05
TOPUP_MIN_AMOUNT=10000
TOPUP_MAX_AMOUNT=500000000
WITHDRAWAL_MIN_AMOUNT=50000
OTP_TTL_MS=300000
PAYMENT_WINDOW_MS=180000
SHIPPING_WINDOW_MS=86400000
AUTO_COMPLETION_WINDOW_MS=432000000
LISTING_MAX_AGE_MS=2592000000
RESET_CREDENTIAL_TTL_MS=3600000
# JWT lifetime is in seconds
JWT_TTL_SECONDS=604800
REPORT_RESTRICTION_THRESHOLD=3
DISPUTE_RESTRICTION_THRESHOLD=3
DISPUTE_RESTRICTION_DURATION_MS=2592000000
