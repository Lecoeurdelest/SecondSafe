# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
LOG_LEVEL=info

# Database (required)
MONGODB_URI=mongodb://localhost:27017/secondsafe

# Security (required)
JWT_SECRET=change-me
CHAT_ENCRYPTION_KEY=change-me-too

# Transactional SMTP (EMAIL_USER/EMAIL_PASS remain supported for Gmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Initial admin account (used by `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=

# Sample seller created by `npm run seed` (local development only)
SEED_SELLER_PASSWORD=

# Business overrides (integer VND and milliseconds unless noted)
PLATFORM_FEE_RATE=0.05
TOPUP_MIN_AMOUNT=10000
TOPUP_MAX_AMOUNT=500000000
WITHDRAWAL_MIN_AMOUNT=50000
OTP_TTL_MS=300000
PAYMENT_WINDOW_MS=180000
SHIPPING_WINDOW_MS=86400000
AUTO_COMPLETION_WINDOW_MS=432000000
LISTING_MAX_AGE_MS=2592000000
RESET_CREDENTIAL_TTL_MS=3600000
# JWT lifetime is in seconds
JWT_TTL_SECONDS=604800
REPORT_RESTRICTION_THRESHOLD=3
DISPUTE_RESTRICTION_THRESHOLD=3
DISPUTE_RESTRICTION_DURATION_MS=2592000000
